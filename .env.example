# Port the HTTP server listens on. Defaults to 3000 when unset.
PORT=3000

# Runtime environment name (e.g. development, production, test).
NODE_ENV=development

# Minimum log level emitted by the Nest Logger (e.g. log, error, warn, debug, verbose).
LOG_LEVEL=log

# --- PostgreSQL (local dev datastore, provisioned via docker-compose.yml) ---

# Host port the Postgres container publishes. Change if 5432 is already in use.
POSTGRES_PORT=5432

# Bootstrap superuser used only to run initdb/the init script. The application
# never connects with this role.
POSTGRES_USER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Dedicated application database and non-superuser role, created by
# scripts/db/init-app-db.sh on first container boot.
APP_DB_NAME=backend_api
APP_DB_USER=backend_api
APP_DB_PASSWORD=backend_api

# Connection string the application and tooling (e.g. scripts/db/check-connection.sh)
# should use. Derived from the APP_DB_* / POSTGRES_PORT values above.
DATABASE_URL=postgresql://backend_api:backend_api@localhost:5432/backend_api
